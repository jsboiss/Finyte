# Copy this file to .env in the repository root. Never commit populated .env files.
# Ask the maintainer privately for the shared sandbox credentials and consent IDs.
# Separate Fiskil sign-up/consent is not needed when using the shared sandbox.
# Single quotes keep values literal (including $ characters).
FINYTE_FISKIL_CLIENT_ID=''
FINYTE_FISKIL_CLIENT_SECRET=''
FINYTE_FISKIL_SANDBOX_ENABLED=true
FINYTE_FISKIL_SANDBOX_END_USER_ID=''
FINYTE_FISKIL_SANDBOX_CONSENT_ID=''
